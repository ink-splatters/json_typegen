{
  "name": "json_typegen_web2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "bun run build:wasm && bun run build:web",
    "build:wasm": "RUSTFLAGS= wasm-pack build --target web ../json_typegen_wasm",
    "build:web": "bunx --bun vite build",
    "dev": "bunx --bun vite",
    "preview": "bun run build && bunx --bun vite preview",
    "deploy": "bun run build && firebase deploy",
    "format": "bunx --bun prettier --write src",
    "check": "bunx --bun svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "prettier": "^3.5.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "json_typegen_wasm": "file:../json_typegen_wasm/pkg",
    "shiki": "^3.1.0"
  }
}
